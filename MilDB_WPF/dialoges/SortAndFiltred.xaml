<Window x:Class="MilDB_WPF.dialoges.SortAndFiltred"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilDB_WPF"
        mc:Ignorable="d"
        Title="SortAndFiltred" Height="450" Width="800"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    
    <Grid>
        <Border
    x:Name="BGBorder"
    Background="#FF2E2E2E"
    CornerRadius="20"
    Opacity="0.95">
            <Grid>
                <Border
            x:Name="TopMenuBorder"
            Height="25"
            VerticalAlignment="Top"
            Background="Black"
            CornerRadius="20, 20, 0, 0"
            MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <Label
                    x:Name="Title"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Сортування та фільтри"
                    Foreground="White" />
                        <Border
                    x:Name="CloseProgramButtonBorder"
                    Width="40"
                    Height="25"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                            <Button
                        Width="40"
                        Height="25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Style="{StaticResource TopBarButtonStyle}" />
                        </Border>

                        <Border
                    x:Name="HideButtonBorder"
                    Width="40"
                    Height="25"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                            <Button
                        Width="40"
                        Height="25"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderThickness="0"
                        Click="HideButton_Click"
                        Style="{StaticResource HideTopBarButtonStyle}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="20,45,410,20">
            <Border
                Background="Azure"
                CornerRadius="20, 0, 0, 20" Margin="0,0,0,0">

                <Grid>
                    <Label Content="Сортування" Foreground="Black" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
                    <Button x:Name="SortByNameAndSurname" Content="Сортувати за іменем та прізвищем" Style="{StaticResource GlobalButtonStyle}" VerticalAlignment="Top" Margin="40,60,40,0"/>
                    <Button x:Name="SortByBDate" Content="Сортувати за датою народження" Style="{StaticResource GlobalButtonStyle}" VerticalAlignment="Top" Margin="40,120,40,0"/>
                    <Button x:Name="SortByAddress" Content="Сортувати за адресою" Style="{StaticResource GlobalButtonStyle}" VerticalAlignment="Top" Margin="40,180,40,0"/>
                    <Button x:Name="DefoltInfoS" Content="Повернути за замовчуванням" Style="{StaticResource GlobalButtonStyle}" VerticalAlignment="Top" Margin="40,240,40,0"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Margin="410,45,20,20">
            <Border
                Background="Azure"
                CornerRadius="0, 20, 20, 0" Margin="0,0,0,0">

                <Grid>
                    <Label Content="Фільтрування" Foreground="Black" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
                    <TextBox x:Name="FilterBDate" local:PlaceholderService.Placeholder="Введіть рік народження для фільтрації" PreviewTextInput="FilterBDate_PriviewTextInput" Height="25" BorderBrush="#FF555555" VerticalAlignment="Top" Margin="40,70,40,0"/>
                    <ComboBox x:Name="FilterCategory" IsEditable="True" local:PlaceholderService.Placeholder="Категорія" Height="25" BorderBrush="#FF555555" VerticalAlignment="Top" Margin="40,130,40,0">
                        <ComboBoxItem Content="А"/>
                        <ComboBoxItem Content="Б"/>
                        <ComboBoxItem Content="В"/>
                        <ComboBoxItem Content="Г"/>
                        <ComboBoxItem Content="Д"/>
                    </ComboBox>
                    <ComboBox x:Name="FilterStatus" IsEditable="True" local:PlaceholderService.Placeholder="Статус" Height="25" BorderBrush="#FF555555" VerticalAlignment="Top" Margin="40,190,40,0">
                        <ComboBoxItem Content="Придатний"/>
                        <ComboBoxItem Content="Відстрочка"/>
                        <ComboBoxItem Content="Непридатний"/>
                    </ComboBox>
                    <Button x:Name="AcceptF" Content="Застосувати" Style="{StaticResource GlobalButtonStyle}" VerticalAlignment="Top" Margin="40,240,40,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

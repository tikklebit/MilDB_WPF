<Window x:Class="MilDB_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilDB_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="20" Background="#FF2E2E2E" Opacity="0.8">
        <Grid>
            <Border CornerRadius="20, 20, 0, 0" Height="25" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="DragWindow">
                <Grid>
                    <Button Content="X" Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Red" BorderThickness="0" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="0,20,0,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            
            <Label Content="СТАРТ" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="70"></Label>
        </Grid>
    </Border>
</Window>
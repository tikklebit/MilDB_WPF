<Window x:Name="MilDBMainWindow" x:Class="MilDB_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="900" Width="1600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border x:Name="BGBorder" CornerRadius="20" Background="#FF2E2E2E" Opacity="0.95">
            <Grid>
                <Border x:Name="TopMenuBorder" CornerRadius="20, 20, 0, 0" Height="25" VerticalAlignment="Top" Background="Black" MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <Label x:Name="Title" HorizontalAlignment="Center" VerticalAlignment="Center" Content="ТАБЛИЦЯ" Foreground="White"/>
                        <Border x:Name="CloseProgramButtonBorder" Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0" Click="CloseButton_Click" Style="{StaticResource TopBarButtonStyle}"/>
                        </Border>

                        <Border x:Name="HideButtonBorder" Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Button Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0" Click="HideButton_Click" Style="{StaticResource HideTopBarButtonStyle}"/>
                        </Border>
                    </Grid>
                </Border>


            </Grid>
        </Border>

        <Grid Margin="20, 60, 1120, 20">
            <Border x:Name="ControlCenterBorder" CornerRadius="20, 0, 0, 20" Background="Azure">
                <Grid>
                    <Button x:Name="CreateObjectButton" VerticalAlignment="Top" Margin="40" Content="СТВОРИТИ" Style="{StaticResource GlobalButtonStyle}" Click="OpenSelectWindow_Click"/>
                    <Button x:Name="UpdateTableButton" VerticalAlignment="Top" Margin="40, 120, 40, 0" Content="ОНОВИТИ ТАБЛИЦЮ" Style="{StaticResource GlobalButtonStyle}" Click="UpdateTableButton_Click"/>
                    <Button x:Name="Уви" VerticalAlignment="Top" Margin="40, 200, 40, 0" Content="РЕДАГУВАТИ ІНФОРМАЦІЮ" Style="{StaticResource GlobalButtonStyle}" Click="ChangeInfoButton_Click"/>
                    <Button x:Name="Увинск" VerticalAlignment="Top" Margin="40, 280, 40, 0" Content="ВИДАЛИТИ З БАЗИ" Style="{StaticResource GlobalButtonStyle}" Click="DeleteButton_Click"/>
                    <Button x:Name="SortButton" VerticalAlignment="Top" Margin="40, 360, 40, 0" Content="СОРТУВАТИ" Style="{StaticResource GlobalButtonStyle}" Click="SortMenu"/>
                    <Label x:Name="SortTitle" VerticalAlignment="Center" Margin="40, 70, 40, 0" FontSize="25" Content="Сортувати за..." Visibility="Collapsed"/>
                    <ComboBox x:Name="SortComboBox" VerticalAlignment="Center" Margin="40, 130, 40, 0" Visibility="Collapsed"/>
                    <Button Content="ЗБЕРЕГТИ" VerticalAlignment="Bottom" Margin="40, 0, 40, 40" Style="{StaticResource GlobalButtonStyle}" Click="SaveToFileButton_Click" />
                    <Button Content="ВІДКРИТИ"  VerticalAlignment="Bottom" Margin="40, 0, 40, 120" Style="{StaticResource GlobalButtonStyle}" Click="OpenFromFileButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="490, 60, 20, 20">
            <Border x:Name="TableInfo" CornerRadius="0, 20, 20, 0" Background="Azure">
                <Grid>
                    <Label Content="Таблиця призовників" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,70,0"/>
                    <Grid Margin="10, 60, 70, 10">
                        <DataGrid x:Name="DataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding ID}" Width="30"/>
                                <DataGridTextColumn Header="Призовник" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Дата народження" Binding="{Binding FormattedBirthDate}" Width="*"/>
                                <DataGridTextColumn Header="Адреса проживання" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="Стан здоров'я" Binding="{Binding HealthStatus}" Width="*"/>
                                <DataGridTextColumn Header="Категорія придатності" Binding="{Binding FitnessCategory}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window
    x:Class="MilDB_WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ТАБЛИЦЯ"
    Width="1200"
    Height="700"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Border
            x:Name="BGBorder"
            CornerRadius="20"
            Background="#FF2E2E2E"
            Opacity="0.95">
            <Grid>
                <Border
                    x:Name="TopMenuBorder"
                    CornerRadius="20,20,0,0"
                    Height="40"
                    VerticalAlignment="Top"
                    Background="Black"
                    Opacity="0.98"
                    MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <Label
                            x:Name="Title"
                            Content="ТАБЛИЦЯ"
                            Foreground="White"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        <Border Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button
                                Width="40"
                                Height="25"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                Click="CloseButton_Click"
                                Style="{StaticResource TopBarButtonStyle}" />
                        </Border>
                        <Border Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Button
                                Width="40"
                                Height="25"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                Click="HideButton_Click"
                                Style="{StaticResource HideTopBarButtonStyle}" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Orientation="Vertical" Margin="0,40,0,10">
                    <Menu x:Name="MainMenu" Background="Black" Foreground="White">
                        <MenuItem Header="ФАЙЛ">
                            <MenuItem Background="DarkSlateGray" Header="ЗБЕРЕГТИ" Click="SaveOfficeButton_Click"/>
                            <MenuItem Background="Black" Header="ВІДКРИТИ" Click="OpenOfficeButton_Click"/>
                            <MenuItem Background="DarkSlateGray" Header="ВИХІД" Click="CloseButton_Click"/>
                        </MenuItem>
                        <MenuItem Header="ДІЇ">
                            <MenuItem Background="DarkSlateGray" Header="ДОДАТИ" Click="AddButton_Click"/>
                            <MenuItem Background="Black" Header="РЕДАГУВАТИ" Click="EditButton_Click"/>
                            <MenuItem Background="DarkSlateGray" Header="ВИДАЛИТИ" Click="DeleteButton_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="20,80,20,20">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button Content="ПРИЗОВНИКИ" x:Name="ConscriptTableButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="140" Height="60"
                                Margin="0,0,10,0" Click="ConscriptTableButton_Click"/>
                        <Button Content="ОФІЦЕРИ" x:Name="OfficerTableButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="140" Height="60"
                                Margin="0,0,30,0" Click="OfficerTableButton_Click"/>
                        <Button Content="ДОДАТИ" x:Name="AddButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="120" Height="60"
                                Margin="0,0,10,0" Click="AddButton_Click"/>
                        <Button Content="РЕДАГУВАТИ" x:Name="EditButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="120" Height="60"
                                Margin="0,0,10,0" Click="EditButton_Click"/>
                        <Button Content="ВИДАЛИТИ" x:Name="DeleteButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="120" Height="60"
                                Margin="0,0,30,0" Click="DeleteButton_Click"/>
                        <Button Content="ЗБЕРЕГТИ ТЦК" x:Name="SaveOfficeButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="140" Height="60"
                                Margin="0,0,10,0" Click="SaveOfficeButton_Click"/>
                        <Button Content="ВІДКРИТИ ТЦК" x:Name="OpenOfficeButton"
                                Style="{StaticResource GlobalButtonStyle}" Width="140" Height="60"
                                Margin="0,0,10,0" Click="OpenOfficeButton_Click"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Пошук:" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchTextBox" Width="300" Height="35" FontSize="15"
                                 Style="{StaticResource GlobalTextBoxStyle}" Margin="10,0,0,0"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Сортувати за:" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SortComboBox" Width="200" Height="35" FontSize="15" Margin="10,0,0,0"
              Style="{StaticResource GlobalComboBoxStyle}">
                            <ComboBoxItem Content="ПІБ" Tag="Name"/>
                            <ComboBoxItem Content="Адреса" Tag="Address"/>
                            <ComboBoxItem Content="Дата народження" Tag="BirthDate"/>
                            <ComboBoxItem Content="Стаж (офіцери)" Tag="YearsOfService"/>
                            <ComboBoxItem Content="Звання (офіцери)" Tag="Rank"/>
                        </ComboBox>
                        <Button Content="СОРТУВАТИ" Width="170" Height="50" Margin="10,0,0,0"
            Style="{StaticResource GlobalButtonStyle}" Click="SortButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="DataGrid"
                              Style="{StaticResource GlobalDataGridStyle}"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Height="443"/>

                    <StackPanel x:Name="OfficersSP" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed" IsEnabled="False">
                        <DataGrid x:Name="OfficersDataGrid"
                                  Style="{StaticResource GlobalDataGridStyle}"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Height="443"
                                  Width="350"
                                  Margin="0,0,50,0"/>
                        <DataGrid x:Name="CfODataGrid"
                                  Style="{StaticResource GlobalDataGridStyle}"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Height="443"
                                  Width="750"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

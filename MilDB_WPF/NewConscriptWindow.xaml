<Window x:Class="MilDB_WPF.NewConscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilDB_WPF"
        mc:Ignorable="d"
        Title="NewConscriptWindow" Height="600" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border x:Name="BGBorder" CornerRadius="20" Background="#FF2E2E2E" Opacity="0.95">
            <Grid>
                <!-- Верхня панель -->
                <Border x:Name="TopMenuBorder" CornerRadius="20, 20, 0, 0" Height="25" VerticalAlignment="Top" Background="Black" MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Content="НОВИЙ ПРИЗОВНИК" Foreground="White"/>
                        <Border x:Name="CloseProgramButtonBorder" Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0" Click="CloseButton_Click" Style="{StaticResource TopBarButtonStyle}"/>
                        </Border>

                        <Border x:Name="HideButtonBorder" Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Button Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0" Click="HideButton_Click" Style="{StaticResource HideTopBarButtonStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Основна форма -->
                <Grid Margin="20,40,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ліва колонка -->
                    <StackPanel Grid.Column="0" Margin="10">
                        <!-- Ім'я та прізвище -->
                        <Label Content="Ім'я та прізвище:" Foreground="White" Margin="0,0,0,5"/>
                        <TextBox x:Name="FullNameTextBox" Height="25" Background="#FF444444" Foreground="White" BorderBrush="#FF555555"/>

                        <!-- Дата народження -->
                        <Label Content="Дата народження:" Foreground="White" Margin="0,10,0,5"/>
                        <DatePicker x:Name="BirthDatePicker" Height="25" Foreground="Black" BorderBrush="#FF555555"/>

                        <!-- Адреса проживання -->
                        <Label Content="Адреса проживання:" Foreground="White" Margin="0,10,0,5"/>
                        <TextBox x:Name="AddressTextBox" Height="25" Foreground="Black"/>
                    </StackPanel>

                    <!-- Права колонка -->
                    <StackPanel Grid.Column="1" Margin="10">
                        <!-- Стан здоров'я -->
                        <Label Content="Стан здоров'я:" Foreground="White" Margin="0,0,0,5"/>
                        <TextBox x:Name="HealthStatusTextBox" Height="60" Background="#FF444444" Foreground="White" BorderBrush="#FF555555" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <!-- Категорія придатності -->
                        <Label Content="Категорія придатності:" Foreground="White" Margin="0,10,0,5"/>
                        <ComboBox x:Name="FitnessCategoryComboBox" Height="25" Foreground="Black" BorderBrush="#FF555555">
                            <ComboBoxItem Content="А"/>
                            <ComboBoxItem Content="Б"/>
                            <ComboBoxItem Content="В"/>
                            <ComboBoxItem Content="Г"/>
                            <ComboBoxItem Content="Д"/>
                        </ComboBox>

                        <!-- Статус -->
                        <Label Content="Статус:" Foreground="White" Margin="0,10,0,5"/>
                        <ComboBox x:Name="StatusComboBox" Height="25" Foreground="Black" BorderBrush="#FF555555">
                            <ComboBoxItem Content="придатний"/>
                            <ComboBoxItem Content="відстрочка"/>
                            <ComboBoxItem Content="звільнений"/>
                        </ComboBox>

                    </StackPanel>

                    <!-- Кнопки внизу -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,0" Grid.ColumnSpan="2" Width="474">
                        <Button x:Name="SaveButton" HorizontalAlignment="Left" Content="ЗБЕРЕГТИ" Width="150" Height="50" Style="{StaticResource GlobalButtonStyle}" Click="AddButton_Click"/>
                        <Button x:Name="CancelButton"  HorizontalAlignment="Center" Width="150" Height="50" Content="СКАСУВАТИ" Style="{StaticResource GlobalButtonStyle}"/>
                        <Button x:Name="ExitButton"  HorizontalAlignment="Right" Width="150" Height="50" Content="ВИХІД" Style="{StaticResource GlobalButtonStyle}" Click="ExitButton_Click"/>
                    </Grid>
                </Grid>
                <Label x:Name="ErrorLabel" Grid.Row="2" 
                   Margin="30, 300, 0, 90"
                   Foreground="Red" 
                   FontSize="14" 
                   Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
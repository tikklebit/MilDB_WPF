<Window x:Class="MilDB_WPF.Select"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select" Height="300" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border x:Name="BGBorder" CornerRadius="20" Background="#FF2E2E2E" Opacity="0.95">
            <Grid>
                <Border x:Name="TopMenuBorder" CornerRadius="20, 20, 0, 0" Height="25" VerticalAlignment="Top" Background="Black" MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Content="СТВОРИТИ..." Foreground="White"/>
                        <Border x:Name="CloseProgramButtonBorder" Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Width="40" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0" Click="CloseButton_Click" Style="{StaticResource TopBarButtonStyle}"/>
                        </Border>
                        
                        <Border x:Name="HideButtonBorder" Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Button Width="40" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0" Click="HideButton_Click" Style="{StaticResource HideTopBarButtonStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid Margin="0, 25, 0, 0">
            <Button x:Name="NewConscriptButton" VerticalAlignment="Top" Margin="20" Content="НОВИЙ ПРИЗОВНИК" Style="{StaticResource GlobalButtonStyle}" Click="NewConscriptButton_Click"/>
            <Button x:Name="NewOfficerButton" VerticalAlignment="Center" Margin="20" Content="НОВИЙ ОФІЦЕР" Style="{StaticResource GlobalButtonStyle}"/>
            <Button x:Name="NewMilitaryButton" VerticalAlignment="Bottom" Margin="20" Content="НОВЕ ТЦК" Style="{StaticResource GlobalButtonStyle}"/>
        </Grid>
    </Grid>
</Window>

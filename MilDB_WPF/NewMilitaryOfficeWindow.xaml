<Window x:Class="MilDB_WPF.NewMilitaryOfficeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий ТЦК" Height="350" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border CornerRadius="20" Background="#FF2E2E2E" Opacity="0.95">
            <StackPanel Margin="30">
                <Label Content="Назва військкомату:" Foreground="White"/>
                <TextBox x:Name="NameTextBox" Style="{StaticResource GlobalTextBoxStyle}"/>
                <Label Content="Адреса:" Foreground="White" Margin="0,10,0,0"/>
                <TextBox x:Name="AddressTextBox" Style="{StaticResource GlobalTextBoxStyle}"/>
                <Label Content="Район обслуговування:" Foreground="White" Margin="0,10,0,0"/>
                <TextBox x:Name="ServiceAreaTextBox" Style="{StaticResource GlobalTextBoxStyle}"/>
                <Label x:Name="ErrorLabel" Foreground="Red" Visibility="Collapsed" Margin="0,10,0,0"/>
                <Button Content="ДОДАТИ" Width="120" Height="50" Margin="0,20,0,0" HorizontalAlignment="Center" Style="{StaticResource GlobalButtonStyle}" Click="AddButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
